FROM node:20-alpine

WORKDIR /app

ARG PORT=7860
ARG ADMIN=
ARG ADMIN_SECRET=
ARG UUID=
ARG DOMAIN=
ARG SNI=
ARG HOST_HEADER=
ARG SUB_PATH=sub
ARG WSPATH=ws

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY . .

ENV PORT=$PORT \
	ADMIN=$ADMIN \
	ADMIN_SECRET=$ADMIN_SECRET \
	UUID=$UUID \
	DOMAIN=$DOMAIN \
	SNI=$SNI \
	HOST_HEADER=$HOST_HEADER \
	SUB_PATH=$SUB_PATH \
	WSPATH=$WSPATH
EXPOSE 7860

CMD ["npm", "start"]
